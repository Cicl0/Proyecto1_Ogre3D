material example/stonesFloor{
    technique { 
	pass {  
	    texture_unit {
		texture BeachStones.jpg
	    }
			rtshader_system
			{
				lighting_stage per_pixel
			}
	}
    }
}

material examples/Rockwall
{
	technique
	{
		pass
		{
			texture_unit
			{
				texture rockwall.tga
			}
		}
	}
}

material examples/EnvMappedRustySteel
{
	technique
	{
		pass
		{

			texture_unit
			{
				texture RustySteel.jpg
			}

			texture_unit
			{
				texture spheremap.png
				colour_op_ex add src_texture src_current
				colour_op_multipass_fallback one one
				env_map spherical
			}
		}
	}
}

material examples/BumpyMetal
{
	technique
	{
		pass
		{
			ambient 0.75 0.75 0.75

			texture_unit
			{
				texture BumpyMetal.jpg
			}
		}
	}
}

material examples/Grass
{
	technique
	{
		pass
		{
			lighting on
			ambient 1 1 1
            		diffuse 1 1 1

			texture_unit
			{
				texture grass.png
			}
		}
	}
}

material examples/Wall
{
	technique
	{
		pass
		{
			lighting on
			ambient 1 1 1
            		diffuse 1 1 1

			texture_unit
			{
				texture egyptrockyfull.jpg
			}
		}
	}
}

material examples/BombBlack
{
	technique
	{
		pass
		{
			lighting on
			ambient 0 0 0
			diffuse 0 0 0 1
			specular 0 0 0 1 1
			emissive 0 0 0

			rtshader_system
			{
				lighting_stage per_pixel
			}
		}
	}
}

material Bomb/FuseSmoke
{
	technique
	{
		pass
		{
			lighting off
			scene_blend alpha_blend
			depth_write off
			diffuse vertexcolour

			texture_unit
			{
				texture Smoke15Frames.png
			}
		}
	}
}